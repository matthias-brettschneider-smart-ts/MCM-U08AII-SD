@startuml

!include ../../../include/Interfaces.puml

!define NAME "ClockNone"
!define BELONGS "os"

' defines
package BELONGS {
  class NAME $tag_module $tag_stateless {
    .. information ..
    + GET_CYCLES_PER_SECOND()
    + GET_CYCLE_START_IN_TICKS()
    + GET_CYCLE_NUMBER()
    .. signal control ..
    + StartSignalReception()
    + StartSignalGeneration()
    + StopSignalGeneration()
    .. monitoring ..
    + CheckState()
  }
}

' realizes
NAME -up- "IClock"

' depends on
NAME --( "ICompiler"
NAME --( "IGeneric"

remove @unlinked

@enduml