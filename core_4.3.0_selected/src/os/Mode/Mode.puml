@startuml

!include ../../../include/Interfaces.puml

!define NAME "Mode"
!define BELONGS "os"

' defines
package BELONGS {
  class NAME $tag_module $tag_stateless {
    + Init()
    + Get()
    + Set()
  }
}

' realizes
