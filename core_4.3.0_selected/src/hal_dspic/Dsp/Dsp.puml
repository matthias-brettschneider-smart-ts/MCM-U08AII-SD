    + DIVIDE_SIGNED_REMAINDER()
    + DIVIDE_UNSIGNED()
    + DIVIDE_UNSIGNED_REMAINDER()
  }
}

' realizes
NAME -up- "IDsp"

' depends on

remove @unlinked

@enduml