    + ENABLE()
    + DISABLE()
    + SET_POLARITY()
    + SET_PRIORITY()
    + CONFIRM()
  }
}

' realizes
NAME -up- "IInt"

' depends on
NAME --( "IAssert"
NAME --( "ICompiler"
NAME --( "IController"
